; Engine configuration file.
; 火拼炸弹堂 / Bomb Blitz Arena
; 建议使用 Godot 4.7 打开。

config_version=5

[application]

config/name="火拼炸弹堂"
config/description="俯视角格子炸弹竞技：放弹、走位、抢道具、三局两胜。"
config/version="1.0.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"
boot_splash/bg_color=Color(0.0705882, 0.0745098, 0.109804, 1)
boot_splash/show_image=false

[autoload]

App="*res://src/app.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/resizable=true
window/vsync/vsync_mode=1

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.0705882, 0.0745098, 0.109804, 1)

[audio]

buses/default_bus_layout=""

[input_devices]

pointing/emulate_touch_from_mouse=false
